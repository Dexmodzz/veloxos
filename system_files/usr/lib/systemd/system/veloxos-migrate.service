[Unit]
Description=VeloxOS Overlay-to-Installroot Migration
Documentation=https://veloxos.org
# Run before the sync service so we don't double-install
After=network-online.target systemd-resolved.service veloxos-pkgroot-init.service
Before=veloxos-pkgroot-sync.service
Wants=network-online.target systemd-resolved.service
# Only needed when packages.list exists and migration hasn't run yet
ConditionPathExists=/var/lib/veloxos/packages.list
ConditionPathExists=!/var/lib/veloxos/migration-installroot.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/bash -c 'until nslookup mirrors.fedoraproject.org >/dev/null 2>&1; do echo "Waiting for DNS..."; sleep 2; done'
ExecStart=/usr/libexec/veloxos/veloxos-migrate
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
