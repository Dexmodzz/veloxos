[Unit]
Description=VeloxOS Overlay Mount
Documentation=https://veloxos.org
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/veloxos/veloxos-overlay-mount
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=sysinit.target
