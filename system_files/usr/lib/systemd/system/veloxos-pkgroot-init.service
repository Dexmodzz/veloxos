[Unit]
Description=VeloxOS Package Root Init
Documentation=https://veloxos.org
After=local-fs.target
Before=veloxos-pkgroot-sync.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/veloxos/veloxos-pkgroot-init
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
