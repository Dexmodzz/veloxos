#!/bin/bash
set -euo pipefail

MARKER_FILE="$HOME/.config/veloxos/.firstrun-done"

mkdir -p "$(dirname "$MARKER_FILE")"

# Ensure a locale is set. Inside a systemd --user service LANG is often empty,
# which makes xdg-user-dirs-update fall back to C/English names (or skip
# translation). Source the system locale so folders are created localized
# (e.g. Scrivania, Scaricati), falling back to Italian if nothing is set.
if [ -z "${LANG:-}" ] || [ "${LANG:-}" = "C" ]; then
    if [ -r /etc/locale.conf ]; then
        # shellcheck disable=SC1091
        . /etc/locale.conf
    fi
    export LANG="${LANG:-it_IT.UTF-8}"
fi

if [ ! -f "$MARKER_FILE" ]; then

    # Create standard XDG user directories (Scrivania, Scaricati, Immagini...).
    # Guard against failure so the rest of the first-run setup still proceeds
    # and the marker gets written.
    xdg-user-dirs-update --force || true

    # Create symlink safely
    if [ ! -e "$HOME/.icons" ]; then
        ln -s "$HOME/.local/share/icons" "$HOME/.icons"
    fi

    # Setup Initial Flatpak Overrides
    OVERRIDE="$HOME/.local/share/flatpak/overrides/global"
    mkdir -p "$(dirname "$OVERRIDE")"

    cat > "$OVERRIDE" <<'EOF'
[Context]
filesystems=xdg-config/gtk-3.0:ro;xdg-data/applications;~/.var/app/io.github.benjamimgois.goverlay/data/goverlay;xdg-config/gtk-4.0:ro;/var/mnt;xdg-config/vkBasalt:create;/mnt;xdg-run/.flatpak/com.discordapp.Discord:create;~/.themes;~/.icons;/home;/var/home;xdg-data/icons;xdg-desktop;xdg-config/MangoHud:create;

[Environment]
VK_INSTANCE_LAYERS=VK_LAYER_MANGOHUD_overlay_x86_64
EOF

    touch "$MARKER_FILE"
fi

# Sync system themes so flatpak has access
SYSTEM_THEMES="/usr/share/themes"
USER_THEMES="$HOME/.themes"

mkdir -p "$USER_THEMES"

rsync -a --copy-links \
  --exclude="Clearlooks" \
  --exclude="Crux" \
  --exclude="HighContrast" \
  --exclude="Industrial" \
  --exclude="Mist" \
  --exclude="Raleigh" \
  --exclude="ThinIce" \
  "$SYSTEM_THEMES/" "$USER_THEMES/"

# Set the correct permissions for the user directory 
echo "Setting correct permissions for $USER_THEMES..." 
chown -R "$USER:$USER" "$USER_THEMES"

echo "VeloxOS user setup complete."
