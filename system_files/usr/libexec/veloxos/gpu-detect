#!/bin/bash
# Runs once at first boot — detects GPU vendor and enables the right services.
# AMD and Intel use open-source in-kernel drivers (amdgpu, i915/xe) that load
# automatically via udev. NVIDIA needs the proprietary services enabled.

set -euo pipefail

MARKER=/var/lib/veloxos/gpu-detected
mkdir -p /var/lib/veloxos

LSPCI=$(lspci)

# NVIDIA — check independently so dual GPU laptops (AMD iGPU + NVIDIA dGPU) work correctly
if echo "$LSPCI" | grep -qi "NVIDIA"; then
    echo "gpu-detect: NVIDIA GPU found — enabling nvidia services"
    systemctl enable nvidia-persistenced.service
    systemctl enable nvidia-powerd.service
fi

# AMD iGPU — amdgpu loads automatically, no extra setup needed
if echo "$LSPCI" | grep -qi "Advanced Micro Devices\|AMD.*VGA\|Radeon"; then
    echo "gpu-detect: AMD GPU found — amdgpu loads automatically"
fi

# Intel iGPU — i915/xe loads automatically, no extra setup needed
if echo "$LSPCI" | grep -qi "Intel.*VGA\|Intel.*Graphics\|Intel.*Display"; then
    echo "gpu-detect: Intel GPU found — i915/xe loads automatically"
fi

touch "$MARKER"
